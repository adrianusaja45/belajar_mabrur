#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
CLANG_WARN_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = NO
OTHER_CFLAGS = $(inherited) -Wno-non-modular-include-in-framework-module -Wno-error=non-modular-include-in-framework-module
